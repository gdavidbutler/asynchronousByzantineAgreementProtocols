# Bridge from system.dtc (specification vocabulary, system.md) to C
# symbols used in system.c.  The same dispatch is #include'd at five
# entry points (systemReceived, systemLaunch, systemComplete,
# systemPossessed, systemEvict); C-function-scoped labels keep them
# distinct, and each site fixes the inputs its event cannot vary and
# (void)-discards the outputs it does not apply -- the
# bkr94acsRules.c discriminator pattern.
#
# Round-class constants (SYSTEM_ROUND_*) are file-local macros in
# system.c.  Structural guards (null, out-of-range indices, rounds
# beyond chain reach) stay as C early-exits in each entry point;
# only the obligation rules are bridged.

@"round R relative to self",~roundClass
"R COMPLETE and retained",SYSTEM_ROUND_RETAINED
"R COMPLETE and released",SYSTEM_ROUND_RELEASED
"R is the live instance",SYSTEM_ROUND_LIVE
"R not yet reached",SYSTEM_ROUND_AHEAD

@"sender has evidenced possession of R",~senderPossesses
yes,1
no,0

@"own instance live",~instanceLive
yes,1
no,0

@"participation owed to any round",~participationOwed
yes,1
no,0

@"application value pending",~valuePending
yes,1
no,0

@"own backlog drained",~backlogDrained
yes,1
no,0

@"possession of the prior round",~priorPossession
"short of n-t",SYSTEM_DUTY_HELD
"at n-t, short of all n",SYSTEM_DUTY_TOLERANCE
"at all n, or not retained",SYSTEM_DUTY_MET

@"tolerance elapsed",~toleranceElapsed
yes,1
no,0

@"identity maintenance due",~maintenanceDue
yes,1
no,0

@"all n processes have evidenced possession of R",~allPossess
yes,1
no,0

@"retention budget exceeded",~budgetExceeded
yes,1
no,0

@"R is the oldest retained round",~oldestRetained
yes,1
no,0

# Domain action -> boolean local that drives a post-dispatch side
# effect, applied by the entry point that owns the action:
# - doDeliver:            output SYSTEM_ACT_DELIVER (systemReceived)
# - doServeOwed:          record want bits, output SYSTEM_ACT_SERVE
#                         (systemReceived)
# - doParticipationOwed:  set SYSTEM_F_OWED (systemReceived)
# - doJoin:               output SYSTEM_ACT_JOIN, set SYSTEM_F_LIVE,
#                         clear SYSTEM_F_OWED (systemLaunch)
# - doMaintain:           output SYSTEM_ACT_MAINTAIN, set
#                         SYSTEM_F_LIVE (systemLaunch)
# - doAdmit:              output SYSTEM_ACT_ADMIT, set SYSTEM_F_LIVE
#                         (systemLaunch)
# - doRelease:            retire the round's entry, output
#                         SYSTEM_ACT_RELEASE (systemReceived,
#                         systemComplete, systemPossessed, systemEvict)

@~doDeliver,"deliver the act to the live instance"
1,yes
0,no

@~doServeOwed,"record serve owed to the sender for R"
1,yes
0,no

@~doParticipationOwed,"record participation owed for R"
1,yes
0,no

@~doJoin,"join the oldest owed round"
1,yes
0,no

@~doMaintain,"maintain the next round"
1,yes
0,no

@~doAdmit,"admit the next round"
1,yes
0,no

@~doRelease,"release R"
1,yes
0,no
