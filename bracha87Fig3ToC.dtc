# Bridge from bracha87Fig3.dtc to C symbols, for a lone compile of the
# Fig 3 tables.  Same form as bracha87Fig1ToC.dtc: '~'-prefixed names
# are C identifiers, each value a literal C token.  "accepted" is
# bridged here because the lone compile has no Fig 1 to produce it; in
# the combined compile this row is omitted and Fig 1's output chains.

@"accepted",~accepted
yes,1
no,0

@"have validated",~haveValidated
yes,1
no,0

@"round of this message",~roundOne
1,1
"> 1",0

@"value is 0 or 1",~valueBinary
yes,1
no,0

@"n-t messages in VALID^(k-1) yield v",~witness
yes,1
no,0

# validated < n-t : 0, n-t <= validated < n : 1, validated == n : 2
@"validated messages of this round",~validatedBand
"< n-t",0
">= n-t",1
n,2

# round sweeps < patience : 0, otherwise 1
@"sweeps in this round",~patienceBand
"< patience",0
">= patience",1

@~validate,"validate (q, k, v)"
1,yes
0,no

@~turn,"turn"
1,yes
0,no
