# Bridge from bracha87Fig4.dtc to C symbols, for a lone compile of the
# Fig 4 tables.  '~'-prefixed names are C identifiers, each value a
# literal C token.  "turn" is bridged here because the lone compile has
# no Fig 3 to produce it; the combined compile omits that row.

@"turn",~turn
yes,1
no,0

# 3i+1 : 1, 3i+2 : 2, 3i+3 : 3
@"round",~round
3i+1,1
3i+2,2
3i+3,3

@"have decided",~haveDecided
yes,1
no,0

# rounds since the decision < 3 : 0, otherwise 1
@"rounds since the decision",~sinceDecisionBand
"< 3",0
">= 3",1

# ones > half the sample : 2, = half : 1, < half : 0
@"sample messages with value 1",~sampleOnes
"> half",2
"= half",1
"< half",0

@"sample messages with value 0 against n/2",~sampleZerosGtHalfN
"> n/2",1
"<= n/2",0

@"sample messages with value 1 against n/2",~sampleOnesGtHalfN
"> n/2",1
"<= n/2",0

# > 2t : 2, > t : 1, <= t : 0
@"sample messages with (d, 0)",~sampleD0
"> 2t",2
"> t",1
"<= t",0

@"sample messages with (d, 1)",~sampleD1
"> 2t",2
"> t",1
"<= t",0

@"message round",~msgRound
3i+1,1
3i+2,2
3i+3,3

# 0 : 0, 1 : 1, (d, 0) : 2, (d, 1) : 3
@"message value",~msgValue
0,0
1,1
"(d, 0)",2
"(d, 1)",3

@"VALID^(k-1) has n-t messages",~prevHasNT
yes,1
no,0

@"VALID^(k-1) messages with the value",~prevSame
"> half",2
"= half",1
"< half",0

@"VALID^(k-1) messages with the value against n/2",~prevSameGtHalfN
"> n/2",1
"<= n/2",0

@"VALID^(k-1) can be read as ?",~prevQuestion
yes,1
no,0

@"VALID^(k-1) messages with (d, the value)",~prevDSameGtT
"> t",1
"<= t",0

@"VALID^(k-1) can be read as coin",~prevCoin
yes,1
no,0

@"VALID^(k-1) holds the sender's (k-1)-message with the value",~prevOwn
yes,1
no,0

# 0, 1, (d, 0), (d, 1), keep, coin
@~valueP,"value_p"
0,0
1,1
2,"(d, 0)"
3,"(d, 1)"
4,keep
5,coin

# 0, 1, no decision : 2
@~decide,"decide"
0,0
1,1
2,no

@~witness,"n-t messages in VALID^(k-1) yield v"
1,yes
0,no

@~cont,"continue"
1,yes
0,no
