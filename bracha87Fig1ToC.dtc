# Bridge from bracha87Fig1.dtc (paper vocabulary) to C symbols used in
# bracha87Fig1Input.  '~'-prefixed names are C boundary symbols; the
# post-'~' text is the bare C identifier and each row's right-hand side
# is the literal C token (constant macro, integer literal) the local
# translator substitutes verbatim into 'if (id == TOKEN) goto Lk;' and
# 'id = TOKEN;'.
#
# Scope: the predicates the paper's and BPR's rows read.  The null
# and range refusals stay as a C-side early-exit -- DTC has no
# ordering insight to add there.  Dedup is not an exit: a duplicate
# records nothing and still runs the dispatch, and "have accepted"
# is a bridged input, because the BPR rows consume the messages the
# paper's rows are finished with.

# Message kind: bridge directly to the function parameter 'type'.
@"kind of message",~type
"(initial, v)",BRACHA87_INITIAL
"(echo, v)",BRACHA87_ECHO
"(ready, v)",BRACHA87_READY

# Per-process state flags reduced to 0/1.
@"have echoed",~haveEchoed
yes,1
no,0

@"have sent ready",~haveSentReady
yes,1
no,0

# Threshold predicates (paper: strict > (n+t)/2 for echo; >= for ready).
@"echo-count(v) > (n+t)/2",~ecGtHalfNT
yes,1
no,0

@"ready-count(v) >= t+1",~rdGeTPlus1
yes,1
no,0

@"ready-count(v) >= 2t+1",~rdGe2TPlus1
yes,1
no,0

# Domain action -> boolean local that drives post-dispatch side effects
# (fig1Echo / memcpy / flag set / out[nout++]=...).

@~sendEcho,"send (echo, v)"
1,yes
0,no

@~sendReady,"send (ready, v)"
1,yes
0,no

@~acceptV,"accept(v)"
1,yes
0,no

# The once-only accept: the flag as the message found it.
@"have accepted",~haveAccepted
yes,1
no,0

# ===========================================================
# Bracha Phase Retry (BPR)
# ===========================================================
#
# Bridge entries for the BPR sub-tables in bracha87Fig1.dtc.  Same
# binding style as above.  The three retire inputs are read from
# the instance in bracha87Fig1Bpr (and fed as 0 by bracha87Fig1Input,
# which discards the retry outputs); the two annotation inputs are
# the caller's flags in bracha87Fig1Input (and 0 / 1 -- nothing
# carried, nothing to arm -- in bracha87Fig1Bpr, which discards the
# annotation outputs).  The wire encoding for retried messages
# re-uses BRACHA87_INITIAL / BRACHA87_ECHO / BRACHA87_READY, so the
# retry outputs bridge to per-action booleans.

@"am initiator",~amInitiator
yes,1
no,0

@"all echoed",~allEchoed
yes,1
no,0

@"READY suppress mask covers all n",~readyMaskFull
yes,1
no,0

@"carries ACCEPTED",~annAccepted
yes,1
no,0

@"carries RECEIVED",~annReceived
yes,1
no,0

@~retryInitial,"retry (initial, v)"
1,yes
0,no

@~retryEcho,"retry (echo, v)"
1,yes
0,no

@~retryReady,"retry (ready, v)"
1,yes
0,no

@~recordSender,"record sender accepted"
1,yes
0,no

@~armSender,"arm re-send to sender"
1,yes
0,no
