# Bridge from bracha87Fig1.dtc (paper, caller and BPR vocabulary) to C
# symbols.  '~'-prefixed names are C boundary symbols; the post-'~' text
# is the bare C identifier and each row's right-hand side is the literal
# C token psu.awk substitutes verbatim into 'if (id == TOKEN) goto Lk;'
# and 'id = TOKEN;'.
#
# The partitioned counters bridge to a band each: the C side does the
# relational test once and hands the band in.

# The event this run is for.
@"event",~sweep
sweep,1
arrival,0

# The paper's inputs.
@"received (initial, v) from p",~receivedInitial
yes,1
no,0

@"echo-count(v) > (n+t)/2",~ecGtHalfNT
yes,1
no,0

@"ready-count(v) >= t+1",~rdGeTPlus1
yes,1
no,0

@"ready-count(v) >= 2t+1",~rdGe2TPlus1
yes,1
no,0

@"have echoed",~haveEchoed
yes,1
no,0

@"have sent ready",~haveSentReady
yes,1
no,0

@"have accepted",~haveAccepted
yes,1
no,0

# The caller's inputs.
@"am initiator",~amInitiator
yes,1
no,0

@"hold the caller's something from p",~holdSomething
yes,1
no,0

# holders < n : 0, holders == n : 1
@"processes holding (initial, v)",~holdingBand
"not all",0
all,1

# process sweeps < abandon : 0, otherwise 1
@"sweeps since this process started",~abandonBand
"< abandon",0
">= abandon",1

@"abandoned",~abandoned
yes,1
no,0

# BPR's inputs: the echo armed, and no process owed (ready, v) : 0,
# some process : 1
@"echo armed",~echoArmed
yes,1
no,0

@"processes owed (ready, v)",~owedBand
none,0
some,1

# The paper's outputs.
@~sendEcho,"send (echo, v)"
1,yes
0,no

@~sendReady,"send (ready, v)"
1,yes
0,no

@~acceptV,"accept v"
1,yes
0,no

# The caller's outputs.
@~takeStep1,"take step 1"
1,yes
0,no

@~takeStep2,"take step 2"
1,yes
0,no

@~takeStep3,"take step 3"
1,yes
0,no

@~abandon,"abandon"
1,yes
0,no

# BPR's outputs.
@~retryInitial,"retry (initial, v)"
1,yes
0,no

@~retryEcho,"retry (echo, v)"
1,yes
0,no

@~retryReady,"retry (ready, v)"
1,yes
0,no
