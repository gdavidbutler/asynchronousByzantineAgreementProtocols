# Bridge from bkr94acs.dtc to C symbols.  Each .dtc compiles alone with
# its own bridge: across files the tables share one or two names, so a
# joint compile has nothing to optimize over and does not finish; the
# chained names -- "accepted" and "take step 3" (Fig 1 to Fig 3),
# "turn" (Fig 3 to Fig 4), "n-t messages in VALID^(k-1) yield v" (Fig 4
# to Fig 3), "decide" (Fig 4 to this file) -- are C locals set by one
# snippet and read by the next.

@"Q(j) = 1 is known",~qKnown
yes,1
no,0

@"my input to BA_j",~myInput
none,0
entered,1

@"BAs completed with output 1",~onesBand
"< n-t",0
">= n-t",1

@"BAs completed",~completedBand
"< n",0
n,1

@"sweeps since n-t completed with output 1",~acsPatienceBand
"< patience",0
">= patience",1

@"have output SubSet",~haveOutput
yes,1
no,0

@"accepted the value of every j in SubSet",~valuesHeld
yes,1
no,0

@~enterOne,"enter 1 to BA_j"
1,yes
0,no

@~enterZero,"enter 0 to BA_j"
1,yes
0,no

@~outputSubSet,"output SubSet"
1,yes
0,no

@~takeSubSet,"take step 3"
1,yes
0,no
